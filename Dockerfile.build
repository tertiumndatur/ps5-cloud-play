FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang-18 \
        cmake \
        dotnet-sdk-8.0 \
        git \
        libclang-rt-18-dev \
        lld-18 \
        llvm-18-dev \
        pkg-config \
        protobuf-compiler \
        python3 \
        python3-pip \
        python3-protobuf \
        python3-venv \
        unzip \
        wget \
        zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
